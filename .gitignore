# ============================================================
# SPEAKWISE - ROOT GITIGNORE
# Flutter + Laravel
# ============================================================

# ----------------------------
# SECRETS / ENVIRONMENT FILES
# ----------------------------
.env
.env.*
!.env.example

**/.env
**/.env.*
!**/.env.example

# API keys / credentials
*.key
*.pem
*.p12
*.pfx

# ----------------------------
# FLUTTER / DART
# ----------------------------
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/.pub-cache/
mobile/.pub/
mobile/build/
mobile/coverage/

# Flutter generated ephemeral files
mobile/windows/flutter/ephemeral/
mobile/linux/flutter/ephemeral/
mobile/macos/Flutter/ephemeral/

# Android generated files
mobile/android/.gradle/
mobile/android/local.properties/
mobile/android/app/debug/
mobile/android/app/profile/
mobile/android/app/release/

# ----------------------------
# LARAVEL / PHP
# ----------------------------
backend/vendor/
backend/node_modules/
backend/public/build/
backend/public/hot

backend/storage/*.key
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/logs/*

!backend/storage/framework/cache/.gitignore
!backend/storage/framework/sessions/.gitignore
!backend/storage/framework/views/.gitignore
!backend/storage/logs/.gitignore

# ----------------------------
# IDE / EDITOR
# ----------------------------
.vscode/
.idea/
*.iml

# ----------------------------
# WINDOWS / OS
# ----------------------------
Thumbs.db
Desktop.ini
.DS_Store

# ----------------------------
# LOGS / TEMP FILES
# ----------------------------
*.log
*.tmp
*.temp

# ----------------------------
# SPEAKWISE LOCAL LAUNCHERS
# ----------------------------
start_speakwise_backend.bat
SpeakWiseLauncher.vbs

# ----------------------------
# BACKUPS / ARCHIVES
# ----------------------------
*.zip
*.rar
*.7z